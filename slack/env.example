# Copy to .env.slack. Settings also load .env; .env.slack takes precedence.
# Find these under Basic Information > App Credentials in your Slack app.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# Run `uv run python -m recallhq.cli slack-init --base-url https://your-host`
# to set the public URL and generate this key without printing it.
SLACK_PUBLIC_URL=
SLACK_ENCRYPTION_KEY=

# Keep these defaults for a commercially distributed app outside the Marketplace.
SLACK_HISTORY_INTERVAL_SECONDS=60
SLACK_HISTORY_PAGE_SIZE=15
SLACK_RECONCILE_INTERVAL_SECONDS=86400
SLACK_USER_COMMANDS_PER_MINUTE=5
SLACK_WORKSPACE_COMMANDS_PER_DAY=200
SLACK_JOB_MAX_ATTEMPTS=8

# Production uses separate query, Slack service, and migration credentials.
# Local docker compose defaults may be used without overriding these.
# DATABASE_URL=postgresql://query_user:...@host/recallhq?sslmode=verify-full
# DATABASE_WRITE_URL=postgresql://slack_service:...@host/recallhq?sslmode=verify-full
# DATABASE_MIGRATION_URL=postgresql://migration_owner:...@host/recallhq?sslmode=verify-full
